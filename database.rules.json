{
  "rules": {
    ".read": false,
    ".write": false,

    "products": {
      ".read": true,
      ".write": "auth != null",
      "$id": {
        ".validate": "newData.hasChildren(['name','price','category'])"
      }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null"
    },

    "orders": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['items','total','customer','status','date']) && (auth != null || newData.child('status').val() === 'new')",
        "items": {
          ".validate": "newData.hasChildren()",
          "$i": {
            ".validate": "newData.hasChildren(['name','price','qty'])",
            "name": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "price": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "qty": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" }
          }
        },
        "total": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'new' || newData.val() === 'ok' || newData.val() === 'done' || newData.val() === 'no')" },
        "date": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "customer": {
          ".validate": "newData.hasChildren(['name','phone','address'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
          "phone": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
          "address": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250" },
          "note": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
